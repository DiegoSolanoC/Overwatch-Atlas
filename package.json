{
  "name": "overwatch-atlas",
  "version": "1.0.0",
  "description": "Overwatch Atlas — interactive lore timeline",
  "scripts": {
    "start": "node scripts/generate-manifest.js && node src/server.js",
    "generate": "node scripts/generate-manifest.js",
    "build:pages": "node scripts/generate-manifest.js && node scripts/prepare-github-pages.mjs",
    "dev": "node scripts/generate-manifest.js && node src/server.js",
    "launch": "node scripts/generate-manifest.js && start cmd /k \"node src/server.js\" && timeout /t 3 /nobreak >nul && start chrome.exe http://localhost:8000",
    "flags:lookup": "node scripts/build-flags-lookup.mjs",
    "scrape:interactions": "node scripts/scrape-wiki-interactions.mjs",
    "scrape:interactions:all": "node scripts/scrape-all-wiki-interactions.mjs",
    "import:interactions": "node scripts/import-interaction-folder.mjs",
    "import:interactions:all": "node scripts/import-all-interaction-batches.mjs",
    "import:favorite-animal-paths": "node scripts/import-favorite-animal-paths.mjs",
    "import:periodic-table-paths": "node scripts/import-periodic-table-paths.mjs",
    "audit:dialogue-duplicates": "node scripts/audit-dialogue-duplicate-conversations.mjs",
    "cleanup:dialogue-theater": "node scripts/cleanup-dialogue-theater.mjs",
    "backfill:heroic-renders": "node scripts/backfill-heroic-renders.mjs",
    "repair:dialogue-paths": "node scripts/repair-dialogue-paths-from-wiki.mjs",
    "import:missing-wiki-interactions": "node scripts/import-missing-wiki-interactions.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}



